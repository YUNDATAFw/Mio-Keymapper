<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <queries>
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.netease.x19" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".app.Mio"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.澪"
        tools:targetApi="31">
        <activity
            android:name=".DeveloperModeActivity"
            android:exported="false" />
        <activity
            android:name=".ShizukuManageActivity"
            android:exported="false" />
        <activity
            android:name=".ImeTestActivity"
            android:exported="false" />
        <activity
            android:name=".GyroTestActivity"
            android:exported="false" />
        <activity
            android:name=".SubscriptionActivity"
            android:exported="false" />
        <activity
            android:name=".DeveloperActivity"
            android:exported="false" />
        <activity
            android:name=".HelpActivity"
            android:exported="false" />
        <activity
            android:name=".UserAgreementActivity"
            android:exported="false" />
        <activity
            android:name=".OpenSourceLicenseActivity"
            android:exported="false" />
        <activity
            android:name=".PermissionGuideActivity"
            android:exported="false" />
        <activity
            android:name=".PermissionActivity"
            android:exported="false" />
        <activity
            android:name=".TerminalActivity"
            android:exported="false" />
        <activity
            android:name=".SecurityActivity"
            android:exported="false" />
        <activity
            android:name=".RunLogActivity"
            android:exported="false" />
        <activity
            android:name=".CrashLogActivity"
            android:exported="false" />
        <activity
            android:name=".CheckUpdateActivity"
            android:exported="false" />
        <activity
            android:name=".DonateActivity"
            android:exported="false" />
        <activity
            android:name=".BackupActivity"
            android:exported="false" />
        <activity
            android:name=".ImportBackupActivity"
            android:exported="false" />
        <activity
            android:name=".ClearDataActivity"
            android:exported="false" />
        <activity
            android:name=".PostDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>
        <activity
            android:name=".CategoryActivity"
            android:exported="false" />
        <activity
            android:name=".ResourceDetailActivity"
            android:exported="false" />
        <activity
            android:name=".CreatePostActivity"
            android:exported="false" />
        <activity
            android:name=".CreateResourceActivity"
            android:exported="false" />
        <activity
            android:name=".MyMessagesActivity"
            android:exported="false" />
        <activity
            android:name=".ChatListActivity"
            android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DownloadManagerActivity"
            android:exported="false" />
        <activity
            android:name=".MyFavoritesActivity"
            android:exported="false" />
        <activity
            android:name=".FollowListActivity"
            android:exported="false" />
        <activity
            android:name=".MyPostsActivity"
            android:exported="false" />
        <activity
            android:name=".MyResourcesActivity"
            android:exported="false" />
        <activity
            android:name=".ManuscriptActivity"
            android:exported="false" />
        <activity
            android:name=".UserProfileActivity"
            android:exported="false" />
        <activity
            android:name=".UserSearchActivity"
            android:exported="false" />
        <activity
            android:name=".PostSearchActivity"
            android:exported="false" />
        <activity
            android:name=".ReportActivity"
            android:exported="false" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ForumSectionActivity"
            android:exported="false" />
        <activity
            android:name=".CreateForumSectionActivity"
            android:exported="false" />
        <activity
            android:name=".PluginShopActivity"
            android:exported="false" />
        <activity
            android:name=".VisualEditorActivity"
            android:exported="false" />
        <activity
            android:name=".VisualEditorEventActivity"
            android:exported="false" />
        <activity
            android:name=".ConfigEditActivity"
            android:exported="false" />
        <activity
            android:name=".ConfigInstallActivity"
            android:label="安装配置(json/lhrb)"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.澪">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".pluginconfig.PluginConfigActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.澪" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PluginInstallActivity"
            android:label="安装插件(zip)"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.澪">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".injector.MioAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".tile.InputMethodTileService"
            android:exported="true"
            android:icon="@drawable/material_symbols_keyboard_outline_rounded"
            android:label="@string/tile_ime_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".tile.ImePickerActivity"
            android:theme="@style/Theme.Mio.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />
        <activity
            android:name=".FilePermissionRequestActivity"
            android:theme="@style/Theme.Mio.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />
        <service
            android:name=".floating.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <service
            android:name=".injector.MioImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>