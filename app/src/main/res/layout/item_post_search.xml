<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:contentPadding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvTitle"
                style="?attr/textAppearanceBodyLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/colorOnSecondaryContainer"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="帖子标题" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSection"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/colorSecondaryContainer">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvSection"
                    style="?attr/textAppearanceLabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/colorSecondary"
                    tools:text="板块" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSummary"
            style="?attr/textAppearanceBodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/colorOnSurfaceVariant"
            tools:text="帖子摘要内容..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAuthorAvatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:srcCompat="@drawable/material_symbols_account_circle_outline" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvAuthor"
                style="?attr/textAppearanceLabelSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="作者昵称" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvTime"
                style="?attr/textAppearanceLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="2025-01-01" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvViews"
                style="?attr/textAppearanceLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="128 浏览" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvLikes"
                style="?attr/textAppearanceLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawablePadding="4dp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="15 赞" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvFavorites"
                style="?attr/textAppearanceLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawablePadding="4dp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="5 收藏" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCoins"
                style="?attr/textAppearanceLabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawablePadding="4dp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="3 投币" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
