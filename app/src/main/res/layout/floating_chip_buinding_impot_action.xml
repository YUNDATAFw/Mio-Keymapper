<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:paddingHorizontal="6dp"
            android:gravity="center_vertical">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_drag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/material_symbols_filter_list_rounded"
                app:tint="@color/colorSecondary"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="2dp"
                android:background="@color/colorSecondaryContainer"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_chip_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/colorSecondary"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_marginVertical="2dp"
                android:background="@color/colorBackground"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_chip_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/10"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/colorSecondary"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_marginVertical="2dp"
                android:background="@color/colorBackground"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_chip_paste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="执行当前命令"
                app:srcCompat="@drawable/material_symbols_content_paste_rounded"
                app:tint="@color/colorSecondary"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_marginVertical="2dp"
                android:background="@color/colorBackground"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_chip_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="上一步"
                app:srcCompat="@drawable/material_symbols_arrow_upward_alt_rounded"
                app:tint="@color/colorSecondary"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_marginVertical="2dp"
                android:background="@color/colorBackground"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_chip_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="下一步"
                app:srcCompat="@drawable/material_symbols_arrow_downward_alt_rounded"
                app:tint="@color/colorSecondary"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="3dp"
                android:layout_marginVertical="2dp"
                android:background="@color/colorBackground"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_chip_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="关闭"
                app:srcCompat="@drawable/material_symbols_close_small_rounded"
                app:tint="@color/colorSecondary"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
