<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ShizukuManageActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorSurfaceContainer">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/material_symbols_arrow_back_rounded"
            app:navigationIconTint="@color/colorOnSecondaryContainer"
            app:title="Shizuku管理"
            app:titleTextColor="@color/colorOnSecondaryContainer" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Shizuku 信息头部 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSecondaryContainer">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:padding="6dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:srcCompat="@drawable/shizuku_svgrepo_com"
                        app:tint="@color/colorSecondary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceTitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shizuku"
                        android:textColor="@color/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvShizukuVersion"
                        style="?attr/textAppearanceBodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="版本:-"
                        android:textColor="@color/colorOnSecondaryContainer" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    app:cardBackgroundColor="@color/colorTertiaryContainer">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvShizukuStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp"
                        android:text="已安装"
                        android:textColor="@color/colorTertiary" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 安装Shizuku -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInstall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/colorSecondaryContainer">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="6dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                app:srcCompat="@drawable/material_symbols_deployed_code_update_outline_rounded"
                                app:tint="@color/colorSecondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shizuku未安装"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="当前设备暂未安装Shizuku,请跟随指引安装Shizuku"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnInstallShizuku"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/colorSecondaryContainer"
                        android:text="安装Shizuku"
                        android:textColor="@color/colorSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 授权 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/colorSecondaryContainer">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="6dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                app:srcCompat="@drawable/material_symbols_permdevice_information_outline_rounded"
                                app:tint="@color/colorSecondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="授权"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="请授予本软件调用Shizuku Api的权限,否则部分功能无法使用"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/colorSecondaryContainer"
                        android:text="授权"
                        android:textColor="@color/colorSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 测试连接 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/colorSecondaryContainer">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="6dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                app:srcCompat="@drawable/material_symbols_build_outline_rounded"
                                app:tint="@color/colorSecondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="测试连接"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="请点击此处测试与Shizuku的连接状态"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestConnection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/colorSecondaryContainer"
                        android:text="测试"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        style="@style/Widget.Material3.CardView.Filled">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Log->"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvLogContent"
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="6dp"
                                android:text="-"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 按键映射检测 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKeyMapTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/colorSecondaryContainer">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="6dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                app:srcCompat="@drawable/material_symbols_keyboard_outline_rounded"
                                app:tint="@color/colorSecondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="按键映射检测"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="逐个注入所有按键并回读本窗口收到的keycode/meta,检测映射是否正确;检测期间请勿切换窗口"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestKeyMapping"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/colorSecondaryContainer"
                        android:text="测试全部按键映射"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        style="@style/Widget.Material3.CardView.Filled">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="映射结果->"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvKeyMapResult"
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="6dp"
                                android:text="-"
                                android:textIsSelectable="true"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 虚拟手柄测试 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGamepadTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/colorSecondaryContainer">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="6dp"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                                app:srcCompat="@drawable/material_symbols_keyboard_outline_rounded"
                                app:tint="@color/colorSecondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="虚拟手柄测试"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="创建 Xbox360 虚拟手柄并依次注入全部按键与摇杆/扳机/十字轴,检测 uinput 是否可用;失败时自动降级 SOURCE_GAMEPAD 注入"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTestGamepad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/colorSecondaryContainer"
                        android:text="测试虚拟手柄"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        style="@style/Widget.Material3.CardView.Filled">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                style="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="手柄测试结果->"
                                android:textColor="@color/colorOnSecondaryContainer"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvGamepadResult"
                                style="?attr/textAppearanceLabelMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="6dp"
                                android:text="-"
                                android:textIsSelectable="true"
                                android:textColor="@color/colorSecondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
