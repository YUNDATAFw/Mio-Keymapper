<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".floating.toolBoxFragment.tool.ToolBinaryCoordinateSearchFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- ========== 搜寻进度 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_progress"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurfaceContainer"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="?attr/textAppearanceTitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="搜寻进度"
                            android:textColor="@color/colorSecondary"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_progress_text"
                            style="?attr/textAppearanceHeadlineSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:text="0%"
                            android:textColor="@color/colorOnSecondaryContainer"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="6dp"
                        android:background="@color/colorOutline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/circular_progress_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="0"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 搜索失败 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_error"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorErrorContainer"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceTitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="搜索失败"
                        android:textColor="@color/colorError"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_error_message"
                        style="?attr/textAppearanceLabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="无法进行下一步的搜索请重置"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_error"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/colorError"
                        android:text="重置"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorErrorContainer"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 设置卡片 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_settings"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/colorSurfaceContainer"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceTitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="初始设置"
                        android:textColor="@color/colorOnSecondaryContainer"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceLabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置搜索范围和Y坐标，开始定位"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="搜索范围（格）"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeWidthFocused="3dp"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_search_range"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="1000" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="Y 坐标"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeWidthFocused="3dp"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_y_level"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberSigned"
                            android:text="-63" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="玩家名（可选）"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeWidthFocused="3dp"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_player_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:text="开始搜索"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimaryContainer"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 象限定位 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quadrant"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurfaceContainer"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceTitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="象限定位"
                        android:textColor="@color/colorOnSecondaryContainer"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceLabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="执行下方指令，确认目标在哪个象限后点击对应按钮"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_quadrant_command"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="3dp"
                        app:strokeColor="@color/colorOutline"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_quadrant"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:icon="@drawable/material_symbols_content_copy_outline_rounded"
                                app:iconTint="@color/colorOutline" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_quadrant_command"
                                style="?attr/textAppearanceBodySmall"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:maxLines="2"
                                android:text="--"
                                android:textColor="@color/colorOnSecondaryContainer" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButtonGroup
                        style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_q1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="@color/colorPrimary"
                            android:text="第一象限\nX+ Z-"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/colorPrimaryContainer"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_q2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="@color/colorPrimary"
                            android:text="第二象限\nX- Z-"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/colorPrimaryContainer"
                            android:textStyle="bold" />
                    </com.google.android.material.button.MaterialButtonGroup>

                    <com.google.android.material.button.MaterialButtonGroup
                        style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_q3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="@color/colorPrimary"
                            android:text="第三象限\nX- Z+"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/colorPrimaryContainer"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_q4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="@color/colorPrimary"
                            android:text="第四象限\nX+ Z+"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/colorPrimaryContainer"
                            android:textStyle="bold" />
                    </com.google.android.material.button.MaterialButtonGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 精准定位 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_precision"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurfaceContainer"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceTitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="精准定位"
                        android:textColor="@color/colorOnSecondaryContainer"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_axis_info"
                        style="?attr/textAppearanceLabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前搜索 X 轴"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/linear_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="4dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_current_range"
                        style="?attr/textAppearanceBodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="X: 0 ~ 999 (1000格)"
                        android:textColor="@color/colorOnSecondaryContainer" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_precision_command"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        app:strokeColor="@color/colorOutline"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_precision"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:icon="@drawable/material_symbols_content_copy_outline_rounded"
                                app:iconTint="@color/colorOutline" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_precision_command"
                                style="?attr/textAppearanceBodySmall"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:maxLines="3"
                                android:text="--"
                                android:textColor="@color/colorOnSecondaryContainer" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_has_target"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/colorPrimary"
                        android:text="有目标（内区）"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimaryContainer"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_no_target"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/colorSecondary"
                        android:text="无目标（外区）"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorOnSecondary"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 定位完成 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_result"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurfaceContainer"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceTitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="定位完成"
                        android:textColor="@color/colorOnSecondaryContainer"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceLabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已定位目标坐标，可复制传送指令"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_final_coordinate"
                        style="?attr/textAppearanceHeadlineSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="X=0 Y=0 Z=0"
                        android:textColor="@color/colorOnSecondaryContainer"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_teleport_command"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:strokeColor="@color/colorOutline"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_teleport"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:icon="@drawable/material_symbols_content_copy_outline_rounded"
                                app:iconTint="@color/colorOutline" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_teleport_command"
                                style="?attr/textAppearanceBodySmall"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:text="/tp @s 0 -63 0"
                                android:textColor="@color/colorOnSecondaryContainer" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 重置会话 ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_reset"
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/colorSurfaceContainer"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceTitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="重置会话"
                        android:textColor="@color/colorOnSecondaryContainer"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        style="?attr/textAppearanceLabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除当前搜索进度，重新开始"
                        android:textColor="@color/colorSecondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_session"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:text="重置"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/colorPrimaryContainer"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
