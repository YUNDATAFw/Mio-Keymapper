<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/actionSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="20dp"
        android:text="评论操作"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/colorOnSurface" />

    <LinearLayout
        android:id="@+id/deleteActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/material_symbols_delete_outline_rounded"
            app:tint="@color/colorError" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/deleteActionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="删除评论"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/colorError" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reportActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/material_symbols_block_outline"
            app:tint="@color/colorOnSecondaryContainer" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reportActionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="举报评论"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/colorOnSecondaryContainer" />
    </LinearLayout>
</LinearLayout>