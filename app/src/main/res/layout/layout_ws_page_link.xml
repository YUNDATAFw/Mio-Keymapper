<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/material_symbols_auto_awesome_outline_rounded"
                        app:tint="@color/colorPrimary"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSecondaryContainer"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:text="WS 服务"
                        />
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:cardBackgroundColor="@color/colorSecondaryContainer">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_ws_status"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="未运行"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:hint="监听端口"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_ws_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:text="8000" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ws_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:text="启动服务"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/material_symbols_add_link_rounded"
                            app:tint="@color/colorPrimary"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSecondaryContainer"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:text="连接命令"
                            />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_command"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="?attr/materialIconButtonStyle"
                            app:icon="@drawable/material_symbols_content_copy_outline_rounded"
                            app:iconTint="@color/colorSecondary"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_connect_command"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textStyle="bold"
                            android:textColor="@color/colorSecondary"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:text="-"
                            />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingVertical="6dp"
                        android:paddingHorizontal="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/material_symbols_add_link_rounded"
                            app:tint="@color/colorPrimary"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSecondaryContainer"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:text="连接信息"
                            />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="?attr/materialIconButtonStyle"
                            app:icon="@drawable/material_symbols_content_copy_outline_rounded"
                            app:iconTint="@color/colorSecondary"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/colorOnSecondaryContainer"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:text="主机:"
                            />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_remote_addr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/colorSecondary"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:text="-"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/colorOnSecondaryContainer"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:text="端口:"
                            />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_remote_port"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/colorSecondary"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:text="-"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="10dp"
                        android:paddingBottom="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/colorOnSecondaryContainer"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:text="玩家:"
                            />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_remote_player"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/colorSecondary"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:text="-"
                            />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

