<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scalable_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
            >
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:srcCompat="@drawable/mio"
            android:tint="@color/colorOnSecondaryContainer"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:background="@color/colorOutlineVariant"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:gravity="center">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toolbar_titile"
                style="?attr/textAppearanceLabelMedium"
                android:textColor="@color/colorOnSecondaryContainer"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStatusVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="?attr/textAppearanceLabelSmall"
                android:textColor="@color/colorSecondary"/>
        </LinearLayout>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_margin="6dp"
            android:background="@color/colorOutlineVariant"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:gravity="center">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStatusMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="?attr/textAppearanceLabelSmall"
                android:textColor="@color/colorOnSecondaryContainer"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStatusBarFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS:0"
                style="?attr/textAppearanceLabelSmall"
                android:textColor="@color/colorSecondary"/>
        </LinearLayout>
    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scalableContentNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/mio"
                app:tint="@color/colorSecondary"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvNewStatusVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text=""
                android:textColor="@color/colorSecondary"
                android:textSize="8sp"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@color/colorSurfaceContainer"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="5dp"
                app:srcCompat="@drawable/material_symbols_account_circle_outline"
                app:tint="@color/colorSecondary"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvNewStatusNickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text=""
                android:textColor="@color/colorSecondary"
                android:textSize="8sp"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@color/colorSurfaceContainer"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="5dp"
                app:srcCompat="@drawable/material_symbols_motion_photos_on_outline"
                app:tint="@color/colorSecondary"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvNewStatusModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text=""
                android:textColor="@color/colorSecondary"
                android:textSize="8sp"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="@color/colorSurfaceContainer"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="5dp"
                app:srcCompat="@drawable/material_symbols_rocket_launch_outline_rounded"
                app:tint="@color/colorSecondary"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvNewStatusCps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text=""
                android:textColor="@color/colorSecondary"
                android:textSize="8sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>