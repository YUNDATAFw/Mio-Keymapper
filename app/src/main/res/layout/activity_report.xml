<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorSurfaceContainer">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/material_symbols_arrow_back_rounded"
            app:navigationIconTint="@color/colorOnSecondaryContainer"
            app:title="举报"
            app:titleTextColor="@color/colorOnSecondaryContainer" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="举报对象"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/colorSecondary" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorOutline">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/reportTargetInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text=""
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/colorOnSurfaceVariant" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="举报类型"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/colorSecondary" />

        <LinearLayout
            android:id="@+id/reportTypeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/reportTypeField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="请选择举报类型"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/colorOnSurfaceVariant" />

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/material_symbols_arrow_left_rounded"
                app:tint="@color/colorOnSecondaryContainer" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="4dp"
            android:background="@color/colorOutline" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="补充说明（可选，最多1000字）"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/colorSecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReportContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="补充说明"
            app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLarge"
            app:boxStrokeWidthFocused="3dp"
            app:boxStrokeWidth="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/reportContentField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLength="1000" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReport"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="提交举报" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>